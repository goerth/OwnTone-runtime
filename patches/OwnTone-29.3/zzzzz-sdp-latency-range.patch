 // See AIRPLAY_AUDIO_LATENCY_MS
 #define RAOP_AUDIO_LATENCY_MS                250
+/* What native macOS AirPlay announces to an AirPlay 1 receiver, in samples at
+ * 44100 Hz: 250 ms and 2000 ms. The upper bound is what a positive playback
+ * offset has to fit under, together with the configured start buffer.
+ */
+#define RAOP_NATIVE_SDP_MIN_LATENCY          11025
+#define RAOP_NATIVE_SDP_MAX_LATENCY          88200
 
 // How many RTP packets to buffer for retransmission
 #define RAOP_PACKET_BUFFER_SIZE    1000
@@ -1182,6 +1189,34 @@ raop_parse_auth(struct raop_session *rs, struct evrtsp_request *req)
   return -1;
 }
 
+/* A receiver clamps the playback latency we ask for to the range announced in
+ * the SDP, and it does so silently: every offset past the ceiling produces the
+ * same playout, which looks exactly like a delay setting that does nothing.
+ * The bounds are overridable so a receiver's real ceiling can be found without
+ * a rebuild - a value the receiver refuses, or ignores in favour of its own
+ * hardware buffer, is the answer this exists to get.
+ */
+static uint32_t
+raop_sdp_latency_bound(const char *name, uint32_t fallback)
+{
+  const char *value = getenv(name);
+  char *end;
+  unsigned long parsed;
+
+  if (!value || !*value)
+    return fallback;
+
+  errno = 0;
+  parsed = strtoul(value, &end, 10);
+  if (errno != 0 || end == value || *end != '\0' || parsed == 0 || parsed > UINT32_MAX)
+    {
+      DPRINTF(E_LOG, L_RAOP, "Ignoring %s: '%s' is not a sample count, using %u\n", name, value, fallback);
+      return fallback;
+    }
+
+  return (uint32_t)parsed;
+}
+
 static int
