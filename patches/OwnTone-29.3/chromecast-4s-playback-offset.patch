+// Number of committed packets not yet consumed by this receiver. Unsigned
+// subtraction deliberately handles the 16-bit RTP sequence wrap. The caller
+// keeps this value below half the sequence space, so the result is unambiguous.
+static inline uint16_t
+packet_backlog_get(struct cast_session *cs)
+{
+  return (uint16_t)(cs->master_session->rtp_session->seqnum - cs->seqnum_next);
+}
+
+// Sends at most one packet and never consumes the configured steady-state lag.
+// Both the output writer and RTCP ACK callback use this gate, otherwise a fast
+// ACK loop can drain several seconds of buffered audio in a fraction of that
+// time and make offset_ms inaudible after startup.
+static int
+packet_send_next_if_due(struct cast_session *cs)
+{
+  uint16_t backlog;
+  int ret;
+
+  backlog = packet_backlog_get(cs);
+  if (backlog <= cs->target_lag_packets)
+    return 0;
+
+  ret = packet_send_next(cs);
+  if (ret == 0)
+    {
+      DPRINTF(E_LOG, L_CAST, "Packet cursor for '%s' fell outside RTP history (next=%" PRIu16 ", producer=%" PRIu16 ", backlog=%" PRIu16 ", target=%" PRIu16 ")\n",
+        cs->devname, cs->seqnum_next, cs->master_session->rtp_session->seqnum,
+        backlog, cs->target_lag_packets);
+      return -1;
+    }
+  if (ret < 0)
+    return ret;
+
+  return 1;
+}
