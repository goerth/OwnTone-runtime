+// macOS does not provide timerfd or POSIX timer overrun counts. A libevent
+// timeout wakes the player, while this absolute deadline restores any 10 ms
+// ticks coalesced while the player thread was busy writing to outputs.
+static struct timespec pb_timer_next_tick;
