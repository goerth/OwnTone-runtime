 static struct event *pb_timer_ev;
 
@@ -336,6 +342,46 @@
 // True if we are trying to recover from a major playback timer overrun (write problems)
 static bool pb_write_recovery;
 
+#if !defined(HAVE_TIMERFD) && !defined(HAVE_TIMER_SETTIME)
+static struct timespec
+timespec_multiply(struct timespec value, uint64_t multiplier)
+{
+  struct timespec result;
+  uint64_t nanoseconds;
+
+  nanoseconds = (uint64_t)value.tv_nsec * multiplier;
+  result.tv_sec = value.tv_sec * multiplier + nanoseconds / 1000000000ULL;
+  result.tv_nsec = nanoseconds % 1000000000ULL;
+
+  return result;
+}
+
+static uint64_t
+pb_timer_ticks_due(struct timespec now)
+{
+  struct timespec elapsed;
+  struct timespec advance;
+  uint64_t elapsed_ns;
+  uint64_t interval_ns;
+  uint64_t ticks_due;
+
+  ticks_due = 1;
+  if (timespec_cmp(now, pb_timer_next_tick) >= 0)
+    {
+      elapsed = timespec_sub(now, pb_timer_next_tick);
+      elapsed_ns = (uint64_t)elapsed.tv_sec * 1000000000ULL + elapsed.tv_nsec;
+      interval_ns = (uint64_t)player_tick_interval.tv_sec * 1000000000ULL + player_tick_interval.tv_nsec;
+      if (interval_ns > 0)
+        ticks_due += elapsed_ns / interval_ns;
+    }
+
+  advance = timespec_multiply(player_tick_interval, ticks_due);
+  pb_timer_next_tick = timespec_add(pb_timer_next_tick, advance);
+
+  return ticks_due;
+}
+#endif
+
