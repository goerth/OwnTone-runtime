+/* Upstream sends 0x07 here, the value iTunes uses, which shairport-sync's
+ * rtp.c reads as telling the receiver to add an 11025 sample latency of its
+ * own; 0x04 is what pure AirPlay sends and does not. The native compatibility
+ * profile picked 0x04 to match a captured macOS session. If a receiver takes
+ * its latency from this byte rather than from the packet's own timestamps,
+ * that choice decides whether an offset can reach it at all, so it is settable
+ * with SOUNDFERRY_RAOP_NATIVE_SYNC_FLAG.
+ */
+static uint8_t
+raop_native_sync_flag(void)
+{
+  static bool resolved;
+  static uint8_t flag;
+  const char *value;
+
+  if (resolved)
+    return flag;
+
+  value = getenv("SOUNDFERRY_RAOP_NATIVE_SYNC_FLAG");
+  flag = (value && *value) ? (uint8_t)strtoul(value, NULL, 0) : 0x04;
+  resolved = true;
+
+  DPRINTF(E_LOG, L_RAOP, "Native sync packets will carry flag byte 0x%02x\n", flag);
+
+  return flag;
+}
