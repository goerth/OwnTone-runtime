+static enum command_state
+speaker_channel_mode_set(void *arg, int *retval)
+{
+  struct speaker_attr_param *param = arg;
+  struct output_device *device;
+  char key[80];
+
+  *retval = -1;
+  if (param->channel_mode < OUTPUT_CHANNEL_STEREO || param->channel_mode > OUTPUT_CHANNEL_RIGHT)
+    return COMMAND_END;
+  device = outputs_device_get(param->spk_id);
+  if (!device)
+    return COMMAND_END;
+  if (device->type != OUTPUT_TYPE_RAOP && device->type != OUTPUT_TYPE_AIRPLAY
+#ifdef CHROMECAST
+      && device->type != OUTPUT_TYPE_CAST
+#endif
+      )
+    return COMMAND_END;
+
+  // The active session snapshots its mode. Do not report success if the
+  // change cannot take effect: the caller must first stop the output.
+  if (device->session)
+    return COMMAND_END;
+
+  snprintf(key, sizeof(key), "soundferry.channel_mode.%" PRIu64, device->id);
+  if (db_admin_setint(key, param->channel_mode) < 0)
+    return COMMAND_END;
+  device->channel_mode = param->channel_mode;
+  *retval = 0;
   return COMMAND_END;
 }
 
