+#ifndef SOUNDFERRY_CHANNEL_MAP_H
+#define SOUNDFERRY_CHANNEL_MAP_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+/* Interleaved, native-endian, signed 16-bit stereo, as used by XCODE_PCM16. */
+static int
+soundferry_channel_map_pcm16(uint8_t *buffer, size_t size, int mode)
+{
+  size_t offset;
+  if (!buffer || size % (2 * sizeof(int16_t)) || mode < 0 || mode > 3)
+    return -1;
+  for (offset = 0; offset < size; offset += 2 * sizeof(int16_t))
+    {
+      int16_t l, r, v;
+      memcpy(&l, buffer + offset, sizeof(l));
+      memcpy(&r, buffer + offset + sizeof(l), sizeof(r));
+      switch (mode)
+        {
+          case 0: continue;
+          case 1: v = (int16_t)(((int32_t)l + (int32_t)r) / 2); break;
+          case 2: v = l; break;
+          case 3: v = r; break;
+          default: return -1;
+        }
+      memcpy(buffer + offset, &v, sizeof(v));
+      memcpy(buffer + offset + sizeof(v), &v, sizeof(v));
+    }
+  return 0;
+}
+#endif
