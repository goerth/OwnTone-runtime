+#ifndef SOUND_FERRY_CHANNEL_MIX_H
+#define SOUND_FERRY_CHANNEL_MIX_H
+#include <stdint.h>
+#include <stddef.h>
+enum channel_mode { CHANNEL_STEREO, CHANNEL_MONO, CHANNEL_LEFT, CHANNEL_RIGHT };
+/* Interleaved native-endian signed 16-bit stereo; output must have 2*frames samples. */
+static inline int channel_mix_pcm16(int16_t *out, const int16_t *in, size_t frames, enum channel_mode mode)
+{
+    if (!out || !in || mode < CHANNEL_STEREO || mode > CHANNEL_RIGHT) return -1;
+    for (size_t i = 0; i < frames; ++i) {
+        int16_t l = in[2*i], r = in[2*i+1];
+        switch (mode) {
+        case CHANNEL_STEREO: out[2*i] = l; out[2*i+1] = r; break;
+        case CHANNEL_MONO: out[2*i] = out[2*i+1] = (int16_t)(((int32_t)l + r) / 2); break;
+        case CHANNEL_LEFT: out[2*i] = out[2*i+1] = l; break;
+        case CHANNEL_RIGHT: out[2*i] = out[2*i+1] = r; break;
+        }
+    }
+    return 0;
+}
+#endif
