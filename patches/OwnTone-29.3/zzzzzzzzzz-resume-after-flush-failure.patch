 static enum command_state
+playback_recovery_start(void *arg, int *retval)
+{
+  // This check runs in the player thread, serialized with pause and stop.
+  if (!player_flush_recovery || player_state != PLAY_PAUSED)
+    {
+      *retval = 1; // Skip playback_start_bh.
+      return COMMAND_END;
+    }
+
+  player_flush_recovery = false;
+  player_flush_pending = 0;
+  return playback_start(arg, retval);
+}
