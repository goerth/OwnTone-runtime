+	    DPRINTF(E_LOG, L_RAOP, "Start sync anchor for '%s': anchor=%" PRIu32 " next_packet=%" PRIu32 " (anchor lead %d samples = %d ms), playing=%" PRIu32 ", latency=%d samples (%d ms), input_buffer=%" PRIu32 " samples\n",
