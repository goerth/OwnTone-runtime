 static void
+udp_inventory_native_packet_resend(struct raop_session *rs, const struct rtp_packet *original)
+{
+  struct rtp_packet reply = { 0 };
+  uint16_t length_words;
+  static unsigned int logged;
+
+  /* Bound addition and the IPv4 UDP payload; RTP needs its complete base header. */
+  if (!original->data || original->data_len < 12 || original->data_len > 65503)
+    {
+      DPRINTF(E_WARN, L_RAOP, "Invalid cached RTP length for native retransmission\n");
+      return;
+    }
+  reply.data_len = original->data_len + 4;
+  reply.data = malloc(reply.data_len);
+  if (!reply.data)
+    {
+      DPRINTF(E_LOG, L_RAOP, "Could not allocate native retransmission packet\n");
+      return;
+    }
+  reply.data[0] = 0x80;
+  reply.data[1] = 0xd6;
+  length_words = htobe16((uint16_t)(reply.data_len / 4 - 1));
+  memcpy(reply.data + 2, &length_words, sizeof(length_words));
+  memcpy(reply.data + 4, original->data, original->data_len);
+  /* Normal target audio uses SSRC zero; never mutate the shared cached packet. */
+  reply.data[5] &= 0x7f;
+  memset(reply.data + 12, 0, 4);
+  if (logged < 4)
+    {
+      DPRINTF(E_LOG, L_RAOP, "Sending native retransmission: seq=%u count=1 socket=control\n",
+              ((unsigned int)original->data[2] << 8) | original->data[3]);
+      logged++;
+    }
+  control_packet_send(rs, &reply);
+  free(reply.data);
+}
