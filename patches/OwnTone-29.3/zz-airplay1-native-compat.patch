+/* Do not use startup_options: it advances the session startup state. */
+static void
+raop_cb_options_keep_alive(struct evrtsp_request *req, void *arg)
+{
+  struct raop_session *rs = arg;
+
+  rs->reqs_in_flight--;
+
+  if (!req || raop_check_cseq(rs, req) < 0)
+    {
+      session_failure(rs);
+      return;
+    }
+
+  if (req->response_code != RTSP_OK)
+    DPRINTF(E_WARN, L_RAOP, "Experimental OPTIONS to '%s' returned %d (proceeding anyway)\n", rs->devname, req->response_code);
+  else if (rs->options_keep_alive_acked < 3)
+    {
+      rs->options_keep_alive_acked++;
+      DPRINTF(E_LOG, L_RAOP, "Experimental OPTIONS acknowledged by '%s' (%u/3 initial confirmations)\n", rs->devname, rs->options_keep_alive_acked);
+    }
+
+  if (!rs->reqs_in_flight)
+    evrtsp_connection_set_closecb(rs->ctrl, raop_rtsp_close_cb, rs);
+}
+
+static void
+raop_options_keep_alive_timer_cb(int fd, short what, void *arg)
+{
+  struct raop_session *rs;
+
+  if (!raop_sessions)
+    return;
+
+  for (rs = raop_sessions; rs; rs = rs->next)
+    {
+      if (rs->state != RAOP_STATE_STREAMING || rs->reqs_in_flight
+          || !(rs->native_compat || (options_keep_alive_device && strcmp(rs->devname, options_keep_alive_device) == 0)))
+        continue;
+
+      if (raop_send_req_options(rs, raop_cb_options_keep_alive, "Experimental keep-alive") < 0)
+        {
+          /* Defer destruction so the session-list iterator remains valid. */
+          deferred_session_failure(rs);
+          continue;
+        }
+
+      if (rs->options_keep_alive_sent < 3)
+        {
+          rs->options_keep_alive_sent++;
+          DPRINTF(E_LOG, L_RAOP, "Experimental OPTIONS sent to '%s' (%u/3 initial sends)\n", rs->devname, rs->options_keep_alive_sent);
+        }
+    }
+
+  evtimer_add(options_keep_alive_timer, &options_keep_alive_tv);
+}
