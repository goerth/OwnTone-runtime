+/* BEGIN NATIVE STARTUP PURE POLICY */
+struct native_startup_gate
+{
+  bool sync_seen;
+  bool audio_started;
+  bool metadata_sent;
+  unsigned int timing_replies;
+  int64_t sync_ms;
+  int64_t audio_ms;
+};
+
+enum native_startup_action
+{
+  NATIVE_STARTUP_WAIT = 0,
+  NATIVE_STARTUP_AUDIO = 1,
+  NATIVE_STARTUP_FLUSH = 2,
+  NATIVE_STARTUP_METADATA = 4,
+  NATIVE_STARTUP_FAIL = 8,
+};
+
+static unsigned int
+native_startup_step(struct native_startup_gate *gate, int64_t now_ms)
+{
+  unsigned int action = NATIVE_STARTUP_AUDIO;
+  int64_t elapsed;
+
+  if (!gate->sync_seen)
+    return NATIVE_STARTUP_WAIT;
+  if (!gate->audio_started)
+    {
+      elapsed = now_ms - gate->sync_ms;
+      if (elapsed >= 5000 && gate->timing_replies == 0)
+        return NATIVE_STARTUP_FAIL;
+      if (elapsed < 300 || gate->timing_replies == 0)
+        return NATIVE_STARTUP_WAIT;
+      gate->audio_started = true;
+      gate->audio_ms = now_ms;
+      action |= NATIVE_STARTUP_FLUSH;
+    }
+  if (!gate->metadata_sent && now_ms - gate->audio_ms >= 1000)
+    {
+      gate->metadata_sent = true;
+      action |= NATIVE_STARTUP_METADATA;
+    }
+  return action;
+}
+/* END NATIVE STARTUP PURE POLICY */
