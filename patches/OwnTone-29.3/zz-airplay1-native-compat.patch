+/* Optional per-device native synchronization comparison. Does not move the
+ * shared RTP/audio cursor. The same CLOCK_MONOTONIC source serves timing replies.
+ */
+static struct rtp_packet *
+udp_inventory_native_sync_next(struct raop_session *rs, struct raop_master_session *rms,
+                               struct rtcp_timestamp stamp, uint8_t type)
+{
+  const char *target = getenv("SOUNDFERRY_RAOP_NATIVE_COMPAT_DEVICE");
+  struct rtp_packet *pkt;
+  struct timespec now;
+  int64_t seconds, delta_ns;
+  uint32_t delta_frames, tail;
+  static bool fallback_logged;
+
+  if (!target || !*target || !rs->devname || strcmp(target, rs->devname) != 0
+      || rms->rtp_session->quality.sample_rate != 44100
+      || clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+    return rtp_sync_packet_next(rms->rtp_session, stamp, type);
+
+  /* Bound before multiplying; stale/future anchors retain the original mapping. */
+  seconds = (int64_t)now.tv_sec - (int64_t)stamp.ts.tv_sec;
+  if (seconds < -1 || seconds > 1)
+    goto fallback;
+  delta_ns = seconds * 1000000000LL + now.tv_nsec - stamp.ts.tv_nsec;
+  if (delta_ns < 0 || delta_ns > 100000000LL)
+    goto fallback;
+
+  delta_frames = (uint32_t)(delta_ns * 44100 / 1000000000LL);
+  stamp.pos += delta_frames;
+  stamp.ts = now;
+  pkt = rtp_sync_packet_next(rms->rtp_session, stamp, type);
+  /* Retain the user's per-speaker offset; native zero-offset lead is 1750 ms.
+   * stamp already includes -offset_samples. Restore it only in the tail, so
+   * the configured offset continues changing playout relative to source time.
+   */
+  tail = htobe32(stamp.pos + rms->output_buffer_samples + (uint32_t)rs->offset_samples);
+  memcpy(pkt->data + 16, &tail, sizeof(tail));
+  return pkt;
+
+ fallback:
+  if (!fallback_logged)
+    {
+      DPRINTF(E_LOG, L_RAOP, "Native sync extrapolation skipped: player timestamp is future or more than 100 ms old\n");
+      fallback_logged = true;
+    }
+  return rtp_sync_packet_next(rms->rtp_session, stamp, type);
+}
