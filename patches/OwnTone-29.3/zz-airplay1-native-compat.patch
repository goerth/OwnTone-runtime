+static int
+raop_add_challenge(struct evrtsp_request *req)
+{
+  uint8_t challenge[16];
+  char *encoded;
+  char *padding;
+  int ret;
+
+  gcry_randomize(challenge, sizeof(challenge), GCRY_STRONG_RANDOM);
+  encoded = b64_encode(challenge, sizeof(challenge));
+  if (!encoded)
+    return -1;
+  padding = strchr(encoded, '=');
+  if (padding)
+    *padding = '\0';
+  ret = evrtsp_add_header(req->output_headers, "Apple-Challenge", encoded);
+  free(encoded);
+  return ret;
 }
 
