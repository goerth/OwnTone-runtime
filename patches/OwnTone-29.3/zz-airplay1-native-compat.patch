+/* The timing socket is shared, but callbacks run serially on one event loop.
+ * With this opt-in profile enabled, explicitly set every IPv4 reply's TOS and
+ * restore zero after sending. Never send if the required setting failed.
+ */
+static int
+udp_inventory_timing_send(int fd, const uint8_t *data, size_t len,
+                          union net_sockaddr *peer, socklen_t peer_len)
+{
+  const char *target = getenv("SOUNDFERRY_RAOP_NATIVE_COMPAT_DEVICE");
+  struct raop_session *rs;
+  int tos, zero = 0, ret, send_errno, observed;
+  socklen_t opt_len;
+
+  if (!target || !*target || peer->sa.sa_family != AF_INET)
+    return sendto(fd, data, len, 0, &peer->sa, peer_len);
+
+  rs = session_find_by_address(peer);
+  tos = (rs && rs->devname && strcmp(target, rs->devname) == 0) ? 0xc0 : 0;
+  if (setsockopt(fd, IPPROTO_IP, IP_TOS, &tos, sizeof(tos)) < 0)
+    {
+      DPRINTF(E_LOG, L_RAOP, "Could not set timing reply TOS; skipping reply: %s\n", strerror(errno));
+      return -1;
+    }
+  opt_len = sizeof(observed);
+  if (getsockopt(fd, IPPROTO_IP, IP_TOS, &observed, &opt_len) < 0 || observed != tos)
+    {
+      DPRINTF(E_LOG, L_RAOP, "Could not verify timing reply TOS; skipping reply\n");
+      if (setsockopt(fd, IPPROTO_IP, IP_TOS, &zero, sizeof(zero)) < 0)
+        DPRINTF(E_LOG, L_RAOP, "Could not restore timing socket TOS: %s\n", strerror(errno));
+      errno = EIO;
+      return -1;
+    }
+
+  ret = sendto(fd, data, len, 0, &peer->sa, peer_len);
+  send_errno = errno;
+  if (setsockopt(fd, IPPROTO_IP, IP_TOS, &zero, sizeof(zero)) < 0)
+    DPRINTF(E_LOG, L_RAOP, "Could not restore timing socket TOS; next reply must set and verify its own TOS: %s\n", strerror(errno));
+  else
+    {
+      opt_len = sizeof(observed);
+      if (getsockopt(fd, IPPROTO_IP, IP_TOS, &observed, &opt_len) < 0 || observed != 0)
+        DPRINTF(E_LOG, L_RAOP, "Could not verify restored timing socket TOS; next reply must set and verify its own TOS\n");
+    }
+  errno = send_errno;
+  return ret;
 }
 
