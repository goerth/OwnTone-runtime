+/* BEGIN IMMEDIATE REQUEST WRITE */
+int
+evrtsp_write_request_now(struct evrtsp_connection *evcon,
+    void (*expected_cb)(struct evrtsp_request *, void *), void *expected_arg)
+{
+  struct evrtsp_request *req;
+  int flags, written;
+
+  if (!evcon || evcon->state != EVCON_WRITING || evcon->fd < 0
+      || evcon->cb != evrtsp_write_connectioncb)
+    return 0;
+  req = TAILQ_FIRST(&evcon->requests);
+  if (!req || req->type != EVRTSP_REQ_FLUSH || req->cb != expected_cb || req->cb_arg != expected_arg)
+    return 0;
+  flags = fcntl(evcon->fd, F_GETFL, 0);
+  if (flags < 0 || !(flags & O_NONBLOCK))
+    return 0;
+
+  /* One nonblocking write only. Caller must destroy this connection on 0/-1;
+   * do not let the ordinary writer finish a partially emitted request later. */
+  event_del(&evcon->ev);
+  written = evbuffer_write(evcon->output_raw, evcon->fd);
+  if (written <= 0 || evbuffer_get_length(evcon->output_raw) != 0)
+    return written < 0 && errno != EAGAIN && errno != EWOULDBLOCK ? -1 : 0;
+
+  /* This internal callback only switches to response reading. No request/user
+   * callback is invoked, and no connection access follows the callback. */
+  evrtsp_write_connectioncb(evcon, NULL);
+  return 1;
+}
+/* END IMMEDIATE REQUEST WRITE */
