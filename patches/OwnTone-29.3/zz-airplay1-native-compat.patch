+static bool
+raop_audio_latency_parse(const char *value, uint32_t *latency)
+{
+  uint64_t parsed = 0;
+  size_t digits = 0;
+
+  while (*value == ' ' || *value == '\t')
+    value++;
+  while (*value >= '0' && *value <= '9')
+    {
+      if (++digits > 10)
+        return false;
+      parsed = parsed * 10 + (*value++ - '0');
+      if (parsed > UINT32_MAX)
+        return false;
+    }
+  while (*value == ' ' || *value == '\t' || *value == '\r')
+    value++;
+  if (!digits || *value)
+    return false;
+  *latency = (uint32_t)parsed;
+  return true;
+}
