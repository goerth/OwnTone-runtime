+static void
+raop_record_latency_observe(struct raop_session *rs, struct evrtsp_request *req)
+{
+  const char *value = evrtsp_find_header(req->input_headers, "Audio-Latency");
+  const char *ctype;
+  char body[257];
+  char *line;
+  char *next;
+  size_t len;
+
+  rs->has_reported_audio_latency = value && raop_audio_latency_parse(value, &rs->reported_audio_latency);
+  ctype = evrtsp_find_header(req->input_headers, "Content-Type");
+  len = evbuffer_get_length(req->input_buffer);
+  if (!rs->has_reported_audio_latency && ctype && strcasecmp(ctype, "text/parameters") == 0
+      && len && len < sizeof(body) && evbuffer_copyout(req->input_buffer, body, len) == len)
+    {
+      if (memchr(body, '\0', len))
+        return;
+      body[len] = '\0';
+      for (line = body; line; line = next)
+        {
+          next = strchr(line, '\n');
+          if (next)
+            *next++ = '\0';
+          if (strncasecmp(line, "Audio-Latency:", 14) == 0
+              && raop_audio_latency_parse(line + 14, &rs->reported_audio_latency))
+            {
+              rs->has_reported_audio_latency = true;
+              break;
+            }
+        }
+    }
+
+  if (rs->has_reported_audio_latency)
+    DPRINTF(E_LOG, L_RAOP, "Receiver '%s' reported Audio-Latency=%u (diagnostic only)\n", rs->devname, rs->reported_audio_latency);
+}
