+void
+outputs_device_offset_set(struct output_device *device)
+{
+  if (outputs[device->type]->disabled || !outputs[device->type]->device_offset_set)
+    return;
+
+  if (!device->session)
+    return; // The next session reads device->offset_ms during setup
+
+  outputs[device->type]->device_offset_set(device);
+}
