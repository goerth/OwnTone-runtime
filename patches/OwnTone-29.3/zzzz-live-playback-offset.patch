+static void
+airplay_device_offset_set(struct output_device *device)
+{
+  struct airplay_session *session = device->session;
+  int previous_offset_samples = session->offset_samples;
+
+  session->offset_samples = device->offset_ms * device->quality.sample_rate / 1000;
+  session->offset_sync_pending = true;
+
+  DPRINTF(E_INFO, L_AIRPLAY,
+    "Updated live offset for '%s': offset_ms=%d, offset_samples=%d, previous_offset_samples=%d; immediate sync queued\n",
+    session->devname,
+    device->offset_ms,
+    session->offset_samples,
+    previous_offset_samples);
+}
