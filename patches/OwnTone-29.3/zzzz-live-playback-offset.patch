+/* Opt in with SOUNDFERRY_RAOP_LIVE_OFFSET_REANCHOR=1 to send the re-anchor
+ * sync packet instead of the routine one when the offset changes.
+ */
+static bool
+raop_live_offset_reanchors(void)
+{
+  static bool resolved;
+  static bool reanchor;
+  const char *value;
+
+  if (resolved)
+    return reanchor;
+
+  value = getenv("SOUNDFERRY_RAOP_LIVE_OFFSET_REANCHOR");
+  reanchor = (value && *value && strcmp(value, "0") != 0);
+  resolved = true;
+
+  DPRINTF(E_LOG, L_RAOP, "Live offset changes will be sent as %s sync packets\n", reanchor ? "re-anchor (0x90)" : "routine (0x80)");
+
+  return reanchor;
+}
