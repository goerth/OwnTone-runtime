+/* Unlike the startup FLUSH, a failure here is not fatal: the stream is already
+ * playing and only the delay adjustment is lost. The sync packet still goes
+ * out, so a receiver that does honour it is not held back by a refused FLUSH.
+ */
+static void
+raop_cb_offset_reanchor_flush(struct evrtsp_request *req, void *arg)
+{
+  struct raop_session *rs = arg;
+
+  rs->reqs_in_flight--;
+  rs->offset_sync_pending = true;
+
+  if (!req || req->response_code != RTSP_OK)
+    DPRINTF(E_LOG, L_RAOP, "Live offset FLUSH was refused by '%s'; sending the sync packet alone\n", rs->devname);
+  else
+    DPRINTF(E_INFO, L_RAOP, "Live offset FLUSH acknowledged by '%s'; re-anchor sync queued\n", rs->devname);
+
+  if (!rs->reqs_in_flight)
+    evrtsp_connection_set_closecb(rs->ctrl, raop_rtsp_close_cb, rs);
+}
